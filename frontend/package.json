{
  "name": "rental-frontend",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://iqiwe.github.io/-",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "build:gh": "node -e \"process.env.STATIC_EXPORT='true'; process.env.NEXT_PUBLIC_BASE_PATH=process.env.NEXT_PUBLIC_BASE_PATH||'/-'; require('child_process').execSync('npx next build', {stdio:'inherit'})\"",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "predeploy": "npm run build:gh",
    "deploy": "gh-pages -d out -t true"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/supercluster": "^7.1.3",
    "leaflet": "^1.9.4",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
