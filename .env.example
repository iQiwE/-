# =============================================================================
# Velvet Residence — Шаблон конфигурации окружения (.env.example)
# Скопируйте этот файл в .env и заполните реальными значениями (НЕ коммитить .env!)
# =============================================================================

# --- Backend (NestJS & Oracle DB) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Разрешенный Origin фронтенда для строгой политики CORS (без '*')
FRONTEND_URL=http://localhost:3000

# Секретный ключ подписи JWT (устанавливается в HttpOnly + Secure cookie)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Подключение к СУБД Oracle Database
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MAX=10
ORACLE_MOCK=false

# --- Frontend (Next.js / React) ---
# В локальной разработке: http://localhost:4000/api/v1
# В продакшене: публичный HTTPS URL вашего бэкенда (например, https://velvet-residence-api.onrender.com/api/v1)
NEXT_PUBLIC_API_URL=
REACT_APP_API_URL=
VITE_API_URL=
